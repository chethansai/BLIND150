from typing import List

class Solution:
    def minMeetingRooms(self, intervals: List[List[int]]) -> int:
        starts = sorted(i[0] for i in intervals)
        ends = sorted(i[1] for i in intervals)

        rooms = 0
        e = 0

        for s in starts:
            if s >= ends[e]:
                e += 1          # a meeting finished, reuse its room
            else:
                rooms += 1      # everyone still busy, open a new room

        return rooms


# Test
s = Solution()
print(s.minMeetingRooms([[0, 30], [5, 10], [15, 20]]))  # 2
print(s.minMeetingRooms([[7, 10], [2, 4]]))             # 1
print(s.minMeetingRooms([[1, 5], [5, 8]]))              # 1
print(s.minMeetingRooms([[1, 10], [2, 6], [3, 8]]))     # 3
